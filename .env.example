# ==============================================
# Migration Hunter — Environment Variables
# ==============================================
# این فایل را به .env تغییر نام دهید و مقادیر را پر کنید.

# ---- AI API Configuration ----
# یکی از موارد زیر را انتخاب کنید:

# OpenAI
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key_here

# یا Gemini
# AI_PROVIDER=gemini
# AI_API_KEY=your_gemini_api_key_here

# ---- Email Configuration (اختیاری) ----
# برای ارسال خودکار ایمیل

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_USE_TLS=true

# ---- General Settings ----
# LOG_LEVEL=INFO
# DEFAULT_COUNTRY=nz
