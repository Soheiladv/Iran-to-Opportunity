# ==============================================
# MigrationHunter — .gitignore
# حفاظت از اطلاعات شخصی
# ==============================================

# ---- اطلاعات شخصی (فایل‌های واقعی) ----
profiles/
output/

# ---- تنظیمات محلی و API Keys ----
.env
.env.local
config.json
secrets.json
email_accounts.json
!.env.example

# ---- حافظه (حاوی اطلاعات شخصی) ----
memory/

# ---- داشبورد (حاوی اطلاعات شخصی) ----
dashboard/
dashboard/archive/

# ---- لینکدین (حاوی اطلاعات شخصی) ----
linkedin_data/

# ---- اسکریپت‌های آرشیو شده ----
scripts_archive/

# ---- تست و موقت ----
test_input.txt
test_setup.py

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Excel تmp ----
*.xlsx.tmp
~$*.xlsx

# ---- آرشیو ----
archive/

# ---- فایل‌های بزرگ ----
*.log
*.tmp

# ---- Python cache ----
*.pyc
*.pyo