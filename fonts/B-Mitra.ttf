	<script>
		document.addEventListener('DOMContentLoaded', function() {
			// انتخاب دکمه همبرگری و کانتینر منو
			const toggleBtn = document.querySelector('.navbar-toggle');
			const navbarCollapse = document.getElementById('navbar');

			if (toggleBtn && navbarCollapse) {
				toggleBtn.addEventListener('click', function() {
					// ۱. تغییر وضعیت کلاس دکمه (برای انیمیشن احتمالی آیکون)
					this.classList.toggle('collapsed');

					// ۲. آپدیت کردن ویژگی دسترسی‌پذیری برای صفحه‌خوان‌ها (Accessibility)
					const isExpanded = this.getAttribute('aria-expanded') === 'true';
					this.setAttribute('aria-expanded', !isExpanded);

					// ۳. باز و بسته کردن منو با اضافه و حذف کلاس 'in' (استاندارد بوت‌استرپ ۳)
					navbarCollapse.classList.toggle('in');
				});
			}
		});
	</script>
